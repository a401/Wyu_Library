# Optional. Copy to .env in the project root; never share the filled file.
# Manual login (npm run login) works without storing a username/password.
WYULIB_USER=
WYULIB_PASS=
WYULIB_DELIVERY_EMAIL=

# Automatic login requires both credentials above. Set 0 to disable.
WYULIB_AUTO_LOGIN=1
WYULIB_AUTO_LOGIN_TIMEOUT_SECONDS=120
WYULIB_LOGIN_TIMEOUT_MS=600000

# Set 0 to disable document-delivery slider assistance.
WYULIB_ASSIST_CAPTCHA_DEFAULT=1

# Prefer installed Edge; fall back to Playwright Chromium if unavailable.
WYULIB_BROWSER_CHANNEL=msedge
# Relative paths are resolved from the project root, not the client's cwd.
WYULIB_BROWSER_PROFILE=browser-profile
WYULIB_DOWNLOAD_DIR=downloads
